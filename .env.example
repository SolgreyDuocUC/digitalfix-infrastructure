# ==============================================================================
# DIGITALFIX - VARIABLES DE ENTORNO CENTRALIZADAS (.env.example)
# ==============================================================================
# Plantilla centralizada para orquestar la plataforma completa de DigitalFix
# desde docker compose en la raíz de digitalfix-infrastructure.
#
# INSTRUCCIONES:
# 1. Copia este archivo como ".env" en esta misma carpeta:
#      cp .env.example .env       (Linux / macOS)
#      copy .env.example .env     (Windows CMD)
#      Copy-Item .env.example .env (PowerShell)
#
# 2. Reemplaza los valores de ejemplo con tus credenciales y configuración real.
#
# 3. Levanta todos los contenedores con un solo comando:
#      docker compose up -d --build
#
# NOTA DE COMPATIBILIDAD:
# Cada microservicio seguirá funcionando de manera individual con su propio .env
# si decides levantarlo por separado. Al ejecutar docker compose en esta carpeta,
# este archivo provee las variables base a todos los servicios de forma centralizada.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS ORACLE AUTONOMOUS (OCI) CON WALLET mTLS
# ------------------------------------------------------------------------------
# Aplica a: ms-login, ms-user, ms-workorders, ms-catalog, ms-notify
# Reemplaza <alias> con el alias de tu base de datos (ej. clx44joct2djmlz9_high).
# TNS_ADMIN=./wallet apunta al directorio montado en cada contenedor (/app/wallet).
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@<alias>_high?TNS_ADMIN=./wallet
SPRING_DATASOURCE_USERNAME=ADMIN
SPRING_DATASOURCE_PASSWORD=tu_password_oracle

# Variables de compatibilidad para ms-user
DB_URL=jdbc:oracle:thin:@<alias>_high?TNS_ADMIN=./wallet
DB_USERNAME=ADMIN
DB_PASSWORD=tu_password_oracle

# ------------------------------------------------------------------------------
# 2. MICROSOFT ENTRA ID (AZURE AD) - RESOURCE SERVER & IDENTIDAD
# ------------------------------------------------------------------------------
# Credenciales comunes de la aplicación registrada en Azure AD
AZURE_TENANT_ID=tu_azure_tenant_id
AZURE_CLIENT_ID=tu_azure_client_id

# ------------------------------------------------------------------------------
# 3. CORS Y FRONTEND
# ------------------------------------------------------------------------------
# Orígenes permitidos separados por coma para peticiones cruzadas
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4000
FRONTEND_PORT=4200

# ------------------------------------------------------------------------------
# 4. PUERTOS PUBLICADOS EN EL HOST (DESARROLLO LOCAL)
# ------------------------------------------------------------------------------
# Solo el frontend y el BFF se publican. Los microservicios no tienen puerto
# en el host: el frontend los consume a través del BFF (red digitalfix-net).
BFF_PORT=8090

# ------------------------------------------------------------------------------
# 5. COMUNICACIÓN INTERNA ENTRE MICROSERVICIOS (RED DOCKER digitalfix-net)
# ------------------------------------------------------------------------------
# Nombre DNS interno del microservicio ms-user para consulta de roles en Docker
MS_USER_URL=http://ms-user-service:8082

# ------------------------------------------------------------------------------
# 6. BROKER DE MENSAJERÍA - RABBITMQ
# ------------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
# Nodos del clúster para los microservicios (failover del cliente AMQP)
RABBITMQ_ADDRESSES=rabbitmq-node1:5672,rabbitmq-node2:5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_NODE2_MANAGEMENT_PORT=15673
# Cookie compartida por los 2 nodos del clúster (cambiarla en la nube)
RABBITMQ_ERLANG_COOKIE=cambiar-por-una-cookie-secreta

# ------------------------------------------------------------------------------
# 7. SERVIDOR SMTP (ENVÍO DE EMAILS - ms-notify)
# ------------------------------------------------------------------------------
SPRING_MAIL_HOST=smtp.mailtrap.io
SPRING_MAIL_PORT=2525
SPRING_MAIL_USERNAME=tu_usuario_smtp
SPRING_MAIL_PASSWORD=tu_password_smtp

# ------------------------------------------------------------------------------
# 8. OPCIONES DE LA JVM
# ------------------------------------------------------------------------------
JAVA_OPTS=-Djava.net.preferIPv4Stack=true
